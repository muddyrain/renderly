APP_ENV=development
API_ADDR=:8080
WEB_ORIGIN=http://localhost:3000
POSTGRES_PORT=5432
DATABASE_URL=postgres://renderly:renderly_dev@localhost:${POSTGRES_PORT:-5432}/renderly?sslmode=disable
REDIS_URL=redis://localhost:6379/0
APP_SECRET=change-me-before-deployment
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=renderly
S3_ACCESS_KEY=renderly
S3_SECRET_KEY=renderly_dev_secret
S3_USE_SSL=false
# Provider keys must remain server-side; never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
IMAGE_PROVIDER=
