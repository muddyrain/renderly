APP_ENV=development
API_ADDR=127.0.0.1:8080
WEB_ORIGIN=http://localhost:3000
POSTGRES_PORT=5432
DATABASE_URL=postgres://renderly:renderly_dev@localhost:5432/renderly?sslmode=disable
REDIS_URL=redis://localhost:6379/0
APP_SECRET=change-me-before-deployment
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=renderly
S3_ACCESS_KEY=renderly
S3_SECRET_KEY=renderly_dev_secret
S3_USE_SSL=false
# Provider keys must remain server-side; never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
IMAGE_PROVIDER=

# Explicit opt-in only: development/test + loopback. No browser identity headers.
RENDERLY_LOCAL_IDENTITY=false
DEV_USER_ID=11111111-1111-4111-8111-111111111111
DEV_WORKSPACE_ID=22222222-2222-4222-8222-222222222222
# DATABASE_URL is literal: change its port explicitly if POSTGRES_PORT changes.
# Connected runner passes only mode/workspace ID/API origin to Next, never this DSN.
